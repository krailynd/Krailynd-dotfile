# n8n.env — example (sanitized). Copy to ~/n8n-stack/.env (chmod 600)
POSTGRES_USER=n8n
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=n8n

N8N_IMAGE_TAG=latest
N8N_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_HEX_32
N8N_USER_MANAGEMENT_JWT_SECRET=REPLACE_WITH_RANDOM_HEX_32

N8N_HOST=n8n.sahacloud.dpdns.org
N8N_PROTOCOL=https
N8N_PORT=5678
WEBHOOK_URL=https://n8n.sahacloud.dpdns.org

EXECUTIONS_MODE=regular
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168

N8N_METRICS=false
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false

BROWSERLESS_TOKEN=REPLACE_WITH_RANDOM_TOKEN
