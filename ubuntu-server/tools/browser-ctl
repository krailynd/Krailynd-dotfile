    res = r.get("result", {})
    print(f"captura {res.get('ancho')}x{res.get('alto')} ({res.get('kb')} KB)")
    print(f"path={ev.get('path')}")
    # Un cosido cortado por el tope de pantallas sigue devolviendo una imagen
    # valida; sin este aviso el modelo la trataria como la pagina entera.
    if r.get("estado") == "parcial":
        print(f"PARCIAL: {r.get('aviso')}")
    return 0


def _analizar(path: str, pregunta: str | None, proveedor: str | None = None,
              nivel: str | None = None) -> int:
    if hermes_vision is None:
        print(f"captura en {path}")
        print("(sin modulo de vision instalado; si tu modelo ve imagenes, lee el fichero)",
              file=sys.stderr)
        return 0
    try:
        r = hermes_vision.analizar(path, pregunta, proveedor, None, nivel)
    except hermes_vision.ErrorVision as e:
        # No es fatal: la captura existe en disco y un modelo con vision puede
        # leerla por su cuenta. Se informa del path para que pueda hacerlo.
        print(f"captura en {path}")
        print(f"ERROR vision: {e}", file=sys.stderr)
        return 1
    if r.get("intentos"):
        print(f"[backends descartados: {len(r['intentos'])}]", file=sys.stderr)
    print(f"[vision {r['proveedor']}/{r['modelo']}]")
    print(r["texto"])
    print(f"\ncaptura={path}")
    return 0


def cmd_analyze(a):
    return _analizar(a.shot, a.pregunta, a.proveedor, a.nivel)


def cmd_see(a):
    """Captura y analiza en un paso: el gesto mas comun con diferencia."""
    p: dict = {"anchoMax": a.ancho}
    if a.selector:
        p["selector"] = a.selector
    if a.label:
        p["etiqueta"] = a.label
    r = llamar("screenshot_full" if a.completa else "screenshot", p, timeout=a.timeout)

    if r.get("estado") == "parcial":
        print(f"AVISO: {r.get('aviso')}", file=sys.stderr)

    shot = (r.get("evidence") or {}).get("screenshot") or {}
    path = shot.get("path")
    if not path:
        print("ERROR: la captura no se guardo en disco", file=sys.stderr)
        return 1
    return _analizar(path, a.pregunta, a.proveedor, a.nivel)


