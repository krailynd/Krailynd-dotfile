def construir_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="browser-ctl",
        description="Capa unica de control del navegador para Hermes (todos los modelos usan esta).",
    )
    sub = p.add_subparsers(dest="sub", required=True)

    s = sub.add_parser("status", help="salud del puente y de la extension")
    s.set_defaults(fn=cmd_status)

    s = sub.add_parser("open", help="navegar a una URL")
    s.add_argument("url")
    s.add_argument("--nueva", action="store_true", help="abrir en pestana nueva")
    s.add_argument("--esperar", default="complete", choices=["dom", "complete", "idle", "none"])
    s.add_argument("--timeout", type=float, default=45)
    s.set_defaults(fn=cmd_open)

    s = sub.add_parser("look", help="resumen compacto de la pagina (lectura por defecto)")
    s.add_argument("--max", type=int, default=60, help="tope de elementos interactivos")
    s.add_argument("--texto", type=int, default=4000, help="tope de texto")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_look)

    s = sub.add_parser("click", help="pulsar un elemento")
    anadir_objetivo(s)
    s.add_argument("--esperar-navegacion", action="store_true")
    s.add_argument("--coordenadas", action="store_true", help="forzar click real por CDP")
    s.set_defaults(fn=cmd_click)

    s = sub.add_parser("type", help="escribir en un campo")
    anadir_objetivo(s)
    s.add_argument("--text", required=True)
    s.add_argument("--enter", action="store_true")
    s.add_argument("--no-limpiar", action="store_true")
    s.add_argument("--real", action="store_true", help="teclear via CDP (sitios exigentes)")
    s.set_defaults(fn=cmd_type)

    s = sub.add_parser("press", help="pulsar una tecla")
    s.add_argument("key")
    s.add_argument("--mod", action="append", choices=["alt", "ctrl", "meta", "shift"])
    s.add_argument("--repetir", type=int, default=1)
    s.set_defaults(fn=cmd_press)

    s = sub.add_parser("scroll", help="desplazar la pagina")
    s.add_argument("--a", choices=["arriba", "abajo", "elemento"])
    s.add_argument("--selector")
    s.add_argument("--dy", type=int)
    s.set_defaults(fn=cmd_scroll)

    s = sub.add_parser("shot", help="captura de pantalla")
    s.add_argument("--label")
    s.add_argument("--selector", help="recortar a este elemento")
    s.add_argument("--completa", action="store_true", help="pagina entera (mas lento)")
    s.add_argument("--ancho", type=int, default=1280)
    s.set_defaults(fn=cmd_shot)

    s = sub.add_parser("see", help="captura Y analiza en un paso (lo habitual)")
    s.add_argument("--pregunta", help="que quieres saber de la pantalla")
    s.add_argument("--selector", help="analizar solo este elemento")
    s.add_argument("--completa", action="store_true", help="pagina entera")
    s.add_argument("--label")
    s.add_argument("--ancho", type=int, default=1280)
    s.add_argument("--timeout", type=float, default=90)
    s.add_argument("--proveedor", choices=PROVEEDORES_VISION or None,
                   help="forzar backend de vision (por defecto: cadena automatica)")
    s.add_argument("--nivel", choices=["rapido", "normal", "profundo"], default="normal",
                   help="exigencia del modelo via router de Omniroute")
    s.set_defaults(fn=cmd_see)

    s = sub.add_parser("analyze", help="analizar una captura ya existente")
    s.add_argument("--shot", required=True, help="ruta del PNG/JPG")
    s.add_argument("--pregunta")
    s.add_argument("--proveedor", choices=PROVEEDORES_VISION or None,
                   help="forzar backend de vision (por defecto: cadena automatica)")
    s.add_argument("--nivel", choices=["rapido", "normal", "profundo"], default="normal",
                   help="exigencia del modelo via router de Omniroute")
    s.set_defaults(fn=cmd_analyze)

    s = sub.add_parser("overlay", help="cursor y marcadores visuales de Hermes")
    s.add_argument("modo", choices=["off", "normal", "debug"])
    s.add_argument("--todas", action="store_true", help="aplicar a todas las pestanas")
    s.set_defaults(fn=cmd_overlay)

    s = sub.add_parser("highlight", help="resaltar un elemento sin actuar sobre el")
    anadir_objetivo(s)
    s.add_argument("--etiqueta")
    s.add_argument("--tipo", choices=["objetivo", "foco", "hover"])
    s.add_argument("--ms", type=int)
    s.set_defaults(fn=cmd_highlight)

    s = sub.add_parser("say", help="mostrar un mensaje de Hermes sobre la pagina")
    s.add_argument("texto")
    s.add_argument("--ms", type=int, default=2600)
    s.set_defaults(fn=cmd_say)

    s = sub.add_parser("site", help="permisos del navegador para un sitio")
    s.add_argument("patron", help='p.ej. "https://ejemplo.com/*"')
    s.add_argument("ajuste", choices=["camera", "microphone", "notifications", "javascript",
                                      "images", "popups", "location", "cookies"])
    s.add_argument("--valor", choices=["allow", "block", "ask", "session_only"],
                   help="omitir para solo consultar")
    s.set_defaults(fn=cmd_site)

    s = sub.add_parser("wait", help="esperar a un selector, un estado o un tiempo")
    s.add_argument("--selector")
    s.add_argument("--ms", type=int)
    s.add_argument("--estado", default="complete", choices=["dom", "complete", "idle"])
    s.add_argument("--timeout", type=float, default=20)
    s.set_defaults(fn=cmd_wait)

    s = sub.add_parser("nav", help="atras / adelante / recargar")
    s.add_argument("accion", choices=["back", "forward", "reload"])
    s.set_defaults(fn=cmd_nav)

    s = sub.add_parser("extract", help="extraer colecciones tipadas")
    s.add_argument("tipo", choices=["links", "forms", "images", "videos", "tables", "meta"])
    s.add_argument("--max", type=int, default=100)
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_extract)

    s = sub.add_parser("elements", help="listar interactivos con sus coordenadas")
    s.add_argument("--max", type=int, default=60)
    s.add_argument("--filtro")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_elements)

    s = sub.add_parser("download", help="descargar una URL")
    s.add_argument("url")
    s.add_argument("--nombre")
    s.add_argument("--timeout", type=float, default=180)
    s.set_defaults(fn=cmd_download)

    s = sub.add_parser("inbox", help="instrucciones pendientes del panel lateral")
    s.set_defaults(fn=cmd_inbox)

    s = sub.add_parser("session", help="estado e historial de la sesion")
    s.add_argument("--historial", type=int, default=10)
    s.set_defaults(fn=cmd_session)

    s = sub.add_parser("reset", help="reiniciar la sesion y el contador de bucles")
    s.set_defaults(fn=cmd_reset)

    s = sub.add_parser("catalogo", help="comandos disponibles en la extension")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_catalogo)

    s = sub.add_parser("raw", help="comando crudo del protocolo")
    s.add_argument("cmd")
    s.add_argument("--json-params", help='JSON con los parametros, p.ej. \'{"max":100}\'')
    s.add_argument("--timeout", type=float, default=60)
    s.set_defaults(fn=cmd_raw)

    return p


def main(argv=None) -> int:
    a = construir_parser().parse_args(argv)
    try:
        return a.fn(a)
    except ErrorControlador as e:
        print(f"ERROR {e.code}: {e.message}", file=sys.stderr)
        if e.detail:
            print(f"  {e.detail}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
