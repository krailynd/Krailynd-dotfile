PROTOCOLO = "2.0.0"

BRIDGE = os.environ.get("HERMES_BRIDGE_URL", "http://127.0.0.1:8770").rstrip("/")
TOKEN_FILE = Path.home() / ".hermes" / "vivaldi-bridge.token"
ESTADO = Path.home() / ".hermes" / "vivaldi" / "adapter-state.json"

# Reintentar solo tiene sentido en fallos transitorios. Reintentar un
# E_BAD_PARAMS es garantia de fallar tres veces en vez de una.
REINTENTABLES = {
    "E_SELECTOR_NOT_FOUND",
    "E_TIMEOUT",
    "E_CONTENT_UNREACHABLE",
    "E_TAB_GONE",
}

MAX_REINTENTOS = 2
ESPERA_REINTENTO = 1.2

# Cortafuegos contra modelos que se atascan repitiendo la misma accion.
MAX_FALLOS_IGUALES = 3     # mismos parametros fallando una y otra vez
MAX_REPETICIONES = 10      # tope duro aunque todo devuelva ok

# Se deriva del modulo de vision en vez de repetirla aqui: una lista duplicada
# se desincroniza en cuanto se anade un backend, y el sintoma es un
# "invalid choice" que no explica nada.
PROVEEDORES_VISION = sorted(hermes_vision.CLAVE_ENV) if hermes_vision else []


class ErrorControlador(Exception):
    def __init__(self, code: str, message: str, detail=None):
        super().__init__(message)
        self.code = code
        self.message = message
        self.detail = detail


# --------------------------------------------------------------- transporte

def _token() -> str:
    env = os.environ.get("HERMES_BRIDGE_TOKEN")
    if env:
        return env
    if TOKEN_FILE.exists():
        return TOKEN_FILE.read_text(encoding="utf-8").strip()
    raise ErrorControlador(
        "E_SIN_TOKEN",
        f"no hay token: ni HERMES_BRIDGE_TOKEN ni {TOKEN_FILE}",
        "arranca el bridge una vez para que lo genere",
    )


def _http(ruta: str, payload=None, timeout: float = 120):
    url = f"{BRIDGE}{ruta}"
    cabeceras = {"Content-Type": "application/json", "X-Hermes-Token": _token()}
    datos = json.dumps(payload).encode("utf-8") if payload is not None else None
    req = urllib.request.Request(url, data=datos, headers=cabeceras,
                                 method="POST" if datos is not None else "GET")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            cuerpo = r.read().decode("utf-8", "replace")
            return json.loads(cuerpo) if cuerpo else {}
    except urllib.error.HTTPError as e:
        cuerpo = e.read().decode("utf-8", "replace")
        try:
            return json.loads(cuerpo)
        except Exception:
            raise ErrorControlador("E_BRIDGE", f"HTTP {e.code}: {cuerpo[:300]}")
    except urllib.error.URLError as e:
        raise ErrorControlador(
            "E_BRIDGE_CAIDO",
            f"no se pudo contactar con el bridge en {BRIDGE}: {e.reason}",
            "arranca el bridge: hermes-vivaldi-bridge",
        )


# --------------------------------------------------------- control de bucles

def _estado_leer() -> dict:
    try:
        return json.loads(ESTADO.read_text(encoding="utf-8"))
    except Exception:
        return {"ultima": None, "repeticiones": 0}


def _estado_escribir(d: dict) -> None:
    try:
        ESTADO.parent.mkdir(parents=True, exist_ok=True)
        ESTADO.write_text(json.dumps(d), encoding="utf-8")
    except Exception:
        pass


def _vigilar_bucle(firma: str) -> None:
    """Corta si el agente repite la misma accion y sigue fallando.

    Ojo con el criterio: cuenta FALLOS consecutivos identicos, no repeticiones
    a secas. El ciclo correcto (look -> actua -> look) repite `look` a
    proposito, y una version anterior de esto lo tomaba por un bucle y
    bloqueaba trabajo legitimo. Lo que de verdad hay que romper es al modelo
    que reintenta el mismo selector roto indefinidamente."""
    st = _estado_leer()
    if st.get("ultima") != firma:
        st = {"ultima": firma, "repeticiones": 1, "fallos": 0}
    else:
        st["repeticiones"] = int(st.get("repeticiones", 0)) + 1
    _estado_escribir(st)

    fallos = int(st.get("fallos", 0))
    if fallos >= MAX_FALLOS_IGUALES:
        _estado_escribir({"ultima": None, "repeticiones": 0, "fallos": 0})
        raise ErrorControlador(
            "E_BUCLE",
            f"esta misma accion ya ha fallado {fallos} veces seguidas",
            "cambia de estrategia: vuelve a leer la pagina con `look`, prueba otro "
            "selector o admite que el paso no es posible",
        )

    # Tope duro contra el giro en vacio, aunque todo devuelva ok.
    if int(st.get("repeticiones", 0)) > MAX_REPETICIONES:
        _estado_escribir({"ultima": None, "repeticiones": 0, "fallos": 0})
        raise ErrorControlador(
            "E_BUCLE",
            f"la misma accion se ha repetido {st['repeticiones']} veces sin cambiar de contexto",
            "estas girando en vacio: replantea el plan o pregunta al usuario",
        )


def _anotar_resultado(firma: str, ok: bool) -> None:
    """Registra como acabo el intento, para que el guardia de bucles distinga
    'repite porque avanza' de 'repite porque esta atascado'."""
    st = _estado_leer()
    if st.get("ultima") != firma:
        return
    st["fallos"] = 0 if ok else int(st.get("fallos", 0)) + 1
    _estado_escribir(st)


# ------------------------------------------------------------------ llamada

def llamar(cmd: str, params: dict | None = None, timeout: float = 120) -> dict:
    """Ejecuta un comando con reintentos acotados. Devuelve el `result`."""
    params = params or {}
    firma = f"{cmd}:{json.dumps(params, sort_keys=True)}"
    _vigilar_bucle(firma)

    ultimo: ErrorControlador | None = None
    for intento in range(MAX_REINTENTOS + 1):
        r = _http("/command", {"cmd": cmd, "params": params, "timeout": timeout}, timeout + 15)

        if r.get("ok"):
            _anotar_resultado(firma, True)
            if intento:
                print(f"[reintento {intento} ok]", file=sys.stderr)
            return r

        err = r.get("error") or {"code": "E_DESCONOCIDO", "message": json.dumps(r)[:300]}
        ultimo = ErrorControlador(err.get("code", "E_DESCONOCIDO"),
                                  err.get("message", ""), err.get("detail"))

        if ultimo.code not in REINTENTABLES or intento == MAX_REINTENTOS:
            _anotar_resultado(firma, False)
            raise ultimo

        print(f"[{ultimo.code} - reintentando {intento + 1}/{MAX_REINTENTOS}]", file=sys.stderr)
        time.sleep(ESPERA_REINTENTO * (intento + 1))

    raise ultimo or ErrorControlador("E_INTERNO", "sin resultado")


# ------------------------------------------------------------------ formato

def _acortar(s: str, n: int) -> str:
    s = re.sub(r"\s+", " ", s or "").strip()
    return s if len(s) <= n else s[: n - 1] + "…"


def formatear_resumen(r: dict) -> str:
    """Convierte page_summary en el formato compacto que consume el modelo."""
    res = r.get("result", {})
    lineas = [
        f"URL    {res.get('url')}",
        f"TITULO {res.get('titulo')}",
    ]

    if res.get("sinCambios"):
        lineas.append("NOTA   la pagina no ha cambiado desde tu ultima lectura")

    encabezados = res.get("encabezados") or []
    if encabezados:
        lineas.append("")
        lineas.append("ENCABEZADOS")
        for h in encabezados[:12]:
            lineas.append(f"  {'#' * h.get('nivel', 1)} {_acortar(h.get('texto', ''), 90)}")

    elementos = res.get("elementos") or []
    if elementos:
        lineas.append("")
        lineas.append(f"INTERACTIVOS ({len(elementos)} de {res.get('elementosTotal')})")
        for e in elementos:
            partes = [f"  [{e['ref']}]", e.get("tag", "")]
            if e.get("tipo"):
                partes.append(f"({e['tipo']})")
            if e.get("texto"):
                partes.append(f'"{_acortar(e["texto"], 60)}"')
            if e.get("placeholder"):
                partes.append(f'ph="{_acortar(e["placeholder"], 40)}"')
            if e.get("href"):
                partes.append(f"-> {_acortar(e['href'], 60)}")
            if e.get("deshabilitado"):
                partes.append("[deshabilitado]")
            lineas.append(" ".join(partes))
        if res.get("elementosTruncados"):
            lineas.append("  … hay mas; filtra con `elements --filtro <texto>`")

    texto = res.get("texto")
    if texto:
        lineas.append("")
        lineas.append("TEXTO")
        lineas.append(_acortar(texto, 1500))

    sc = res.get("scroll") or {}
    if sc:
        lineas.append("")
        lineas.append(
            f"SCROLL y={sc.get('y')} de {sc.get('alturaTotal')}"
            + (" (fin de pagina)" if sc.get("finDePagina") else "")
        )

    return "\n".join(lineas)


def formatear_evidencia(r: dict) -> str:
    ev = r.get("evidence") or {}
    trozos = []
    if ev.get("url"):
        trozos.append(f"url={ev['url']}")
    shot = ev.get("screenshot")
    if isinstance(shot, dict) and shot.get("path"):
        trozos.append(f"captura={shot['path']}")
    return "  ".join(trozos)


def salida(r: dict, como_json: bool, resumen: str | None = None) -> None:
    if como_json:
        print(json.dumps(r, ensure_ascii=False, indent=2))
        return
    if resumen is not None:
        print(resumen)
    else:
        print(json.dumps(r.get("result"), ensure_ascii=False))
    ev = formatear_evidencia(r)
    if ev:
        print(f"\n{ev}")


# ------------------------------------------------------------ objetivo comun

def objetivo(a: argparse.Namespace) -> dict:
    """Traduce --ref/--selector/--texto al objetivo del protocolo."""
    p: dict = {}
    if getattr(a, "ref", None):
        p["ref"] = a.ref
    elif getattr(a, "selector", None):
        p["selector"] = a.selector
    elif getattr(a, "texto", None):
        p["texto"] = a.texto
    else:
        raise ErrorControlador("E_BAD_PARAMS", "indica --ref, --selector o --texto")
    if getattr(a, "nth", None):
        p["nth"] = a.nth
    return p


def anadir_objetivo(sp: argparse.ArgumentParser) -> None:
    sp.add_argument("--ref", help="referencia estable devuelta por look/elements (p.ej. e12)")
    sp.add_argument("--selector", help="selector CSS")
    sp.add_argument("--texto", help="texto visible del elemento")
    sp.add_argument("--nth", type=int, help="si el selector devuelve varios, cual (0-based)")


